{
  "name": "scripture-scribe",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "build:bible": "python3 scripts/build_bible.py",
    "qa": "node scripts/handwriting_qa.mjs",
    "qa:release": "node scripts/verify-release.mjs",
    "build:ios": "DEPLOY_BASE=./ npm run build",
    "cap:sync": "npm run build:ios && cap sync ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "puppeteer-core": "^25.8.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
